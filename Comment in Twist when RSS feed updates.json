      "name": "Twist",
      "type": "n8n-nodes-base.twist",
      "typeVersion": 1,
      "position": [
        860,
        300
      ],
      "parameters": {
        "resource": "comment",
        "threadId": "3413522",
        "content": "=[{{$node[\"RSS Feed Read\"].json[\"title\"]}}]({{$node[\"RSS Feed Read\"].json[\"link\"]}}) by {{$node[\"RSS Feed Read\"].json[\"creator\"]}}",
        "additionalFields": {
