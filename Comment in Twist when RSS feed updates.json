      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "58 */30 * * * *"
            },
            {
              "field": "cronExpression",
              "expression": "33 0 14 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "ed1f90cd-624b-48b7-8b80-a48ff8d8f55f",
      "name": "Function",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\n\nlet newItems = []\n\nconst data = $getWorkflowStaticData(\"node\")\nif (data.guids) {\n  newItems = items.filter((i) => !data.guids.includes(i.guid))\n}\ndata.guids = items.map((i) => i.guid)\n\nreturn newItems"
      }
    },
