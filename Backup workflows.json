    {
      "id": "9c6d8712-22a1-44d5-ab2c-08445b78cc9a",
      "name": "Prepare workflow exports",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        640
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const requiredWorkflowIds = [\"1\", \"10\", \"11\", \"12\", \"13\", \"3\", \"4\", \"5\", \"9\", \"ekNtCLOwi49Vywr9\", \"zpYJO8nYkGZzQ0Qh\"];\n// n8n Code node, Run Once for All Items. No filesystem or network access.\nconst items = $input.all();\nif (!items.length) throw new Error('No workflows returned; refusing an empty backup');\nconst returnedIds = new Set(items.map(item => item.json?.id));\nconst missingIds = requiredWorkflowIds.filter(id => !returnedIds.has(id));\nif (missingIds.length) throw new Error(`Missing required workflow IDs: ${missingIds.join(', ')}`);\nconst ids = new Set();\nconst names = new Set();\n// CLI-style workflow definition, not the API envelope or a second published graph.\n// Explicit fields avoid publishing API-only history/authors/project-folder payloads.\nconst fields = [\n  'updatedAt', 'createdAt', 'id', 'name', 'description', 'active', 'isArchived',\n  'nodes', 'connections', 'settings', 'staticData', 'meta', 'nodeGroups', 'pinData',\n  'versionId', 'activeVersionId', 'versionCounter', 'triggerCount', 'sourceWorkflowId',\n  'tags', 'shared',\n];\nreturn items.map(({json: workflow}, index) => {\n  if (typeof workflow.id !== 'string' || !workflow.id ||\n      typeof workflow.name !== 'string' || !workflow.name ||\n      typeof workflow.versionId !== 'string' || !workflow.versionId ||\n      typeof workflow.isArchived !== 'boolean' ||\n      !Object.hasOwn(workflow, 'description') || typeof workflow.versionCounter !== 'number' ||\n      !Array.isArray(workflow.nodes) || !workflow.connections ||\n      typeof workflow.connections !== 'object' || Array.isArray(workflow.connections) ||\n      !Object.hasOwn(workflow, 'settings') || !Object.hasOwn(workflow, 'staticData') ||\n      !Object.hasOwn(workflow, 'pinData')) {\n    throw new Error('Incomplete workflow response; refusing partial backup');\n  }\n  if (ids.has(workflow.id) || names.has(workflow.name)) {\n    throw new Error(`Duplicate workflow ID or filename at workflow ${workflow.id}; refusing overwrite`);\n  }\n  if (/[\\/\\\\\\x00-\\x1f\\x7f]/.test(workflow.name)) {\n    throw new Error(`Workflow ${workflow.id} name is not a safe root filename`);\n  }\n  // GitHub's path encoder rejects lone surrogates; fail before any upload.\n  encodeURIComponent(workflow.name);\n  ids.add(workflow.id);\n  names.add(workflow.name);\n  const exported = {};\n  for (const field of fields) {\n    if (Object.hasOwn(workflow, field)) exported[field] = workflow[field];\n  }\n  return {json: {data: JSON.stringify(exported, null, 2)}, pairedItem: {item: index}};\n});\n"
      }
    },
